# AMEL environment configuration — copy to .env and fill in real values.
# Never commit .env. This file documents required variables with
# placeholder values only.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL (Milestone 1) ---
# Matches infra/docker-compose.yml's postgres service. Used by amel-db
# (migrations) and stream_ingestor.
DATABASE_URL=postgresql+psycopg://amel:amel_dev_password@localhost:5432/amel

# --- Kafka (Milestone 1) ---
# kafka:9092 from inside docker compose; localhost:29092 from the host
# (see the dual-listener setup in infra/docker-compose.yml).
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- source_simulator (Milestone 1) ---
DATA_DIR=./data/raw
HIGGS_MAX_ROWS=500000
# entity_id numbering starts here; after restarting the simulator set it to
# (max index already in landing + 1) so replayed ids don't all get deduped.
HIGGS_START_INDEX=0
EVENTS_PER_SECOND=100
# Dead/paused broker surfaces in /ready after this long (librdkafka default is 300000).
KAFKA_MESSAGE_TIMEOUT_MS=30000
DUPLICATE_RATE=0.01
INVALID_EVENT_RATE=0.002
LABEL_DELAY_SECONDS=10
BURST_MODE=false
RANDOM_SEED=42

# --- training + MLflow (Milestone 4) — all optional, read by `make train`/`make promote` ---
# Pin the dataset for a reproducible run (labels with label_timestamp <= this); unset = now.
TRAINING_AS_OF=
TRAINING_MAX_ROWS=200000
TRAINING_MAX_DEPTH=8
# Promotion criteria (see DECISIONS.md ADR-0006):
# TRAINING_PROMOTION_MIN_TEST_ACCURACY=0.66
# TRAINING_PROMOTION_MIN_TEST_ROC_AUC=0.70
# TRAINING_PROMOTION_MAX_REGRESSION=0.005

# --- inference API (Milestone 5) ---
# 0 = champion refresh only via POST /model/refresh; >0 = also poll every N seconds
INFERENCE_MODEL_REFRESH_SECONDS=0
# Shared secret for POST /model/refresh until JWT auth lands (Milestone 11)
INFERENCE_ADMIN_TOKEN=dev-admin-token

# --- observability (Milestone 6) ---
# Telemetry is opt-in per process; Compose sets it for every first-party service.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Trace sampling ratio for the Kafka-heavy simulator/ingestor (inference stays at 100%)
OTEL_KAFKA_TRACE_RATIO=0.02

# Milestone-specific variables for later subsystems (MinIO, Feast/Redis,
# MLflow, JWT signing keys, LLM provider keys, etc.) are appended here as
# each is implemented — see PROJECT_STATE.md for what exists today. Do
# not pre-declare variables for services that don't exist yet.
