{
  "uid": "amel-overview",
  "title": "AMEL overview",
  "tags": [
    "amel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events published / s (simulator)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type, outcome) (rate(amel_simulator_events_published_total[1m]))",
          "legendFormat": "{{event_type}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ingestor: persisted vs duplicate vs DLQ / s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(amel_ingestor_messages_consumed_total[1m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka consumer lag (stream-ingestor)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_consumergroup_lag{consumergroup=\"stream-ingestor\"})",
          "legendFormat": "{{topic}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Probes: ready (1 = ready)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amel_simulator_ready",
          "legendFormat": "simulator",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "amel_inference_ready",
          "legendFormat": "inference_api",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Prediction latency p50 / p95 (inference_api)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(amel_inference_prediction_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(amel_inference_prediction_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Predictions / s by outcome",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, outcome) (rate(amel_inference_predictions_total[1m]))",
          "legendFormat": "{{source}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Served model",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "amel_inference_model_info",
          "legendFormat": "{{name}} v{{version}} (@{{alias}})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "name"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RED from traces: request rate by service/route",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 16,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, http_route) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[1m]))",
          "legendFormat": "{{service_name}} {{http_route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Pipeline runs (last 20)",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amel-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT started_at, run_id, status, extracted_features, curated_features_upserted, training_records_new, finished_at - started_at AS duration FROM control.pipeline_runs ORDER BY started_at DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amel-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "table",
      "title": "Predictions per model version (last 24h)",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amel-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT model_version, count(*) AS predictions, round(avg(latency_ms)::numeric,2) AS avg_latency_ms, round(avg(probability)::numeric,3) AS avg_probability FROM ml.predictions WHERE created_at > now() - interval '24 hours' GROUP BY model_version ORDER BY model_version",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amel-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "table",
      "title": "Model promotions (audit)",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amel-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT promoted_at, version, previous_champion_version, decided_by, left(reason, 80) AS reason FROM ml.model_promotions ORDER BY id DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amel-postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}